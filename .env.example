# Adapter Information For Communicating With DLR Dataspace Connector
BASE_URL_DLR_CONNECTOR=https://vision-x-api.base-x-ecosystem.org/connectors/jin-conn
API_KEY_DLR_CONNECTOR=
DATABASE_URL=postgresql+psycopg://admin:admin@db:5432/workflowdb
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
ARTIFACT_ROOT=/artifacts
CELERY_WORKER_CONCURRENCY=4
SCHEDULER_POLL_INTERVAL=0.5
ARTIFACT_RETENTION=3600
RETAIN_FAILED_ARTIFACTS=true
